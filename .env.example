# ── GitHub OAuth app (Settings → Developer settings → OAuth Apps) ──
# Callback URL: https://YOUR-DOMAIN/api/auth/callback/github
GITHUB_ID=
GITHUB_SECRET=

# ── NextAuth ──
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ── Content repository ──
# The repo whose owner gets edit access, and where page edits are committed.
GITHUB_REPO=langluaa/pearlregistry
GITHUB_BRANCH=main

# Fine-grained personal access token with "Contents: Read and write" on GITHUB_REPO.
# Used server-side only: to read pages live and commit the owner's edits.
# Leave empty to run read-only from the local ./content folder (in `npm run dev`, edits write to disk).
GITHUB_TOKEN=

# Optional: extra GitHub usernames (comma-separated) who may edit, besides the repo owner.
REGISTRY_EDITORS=
